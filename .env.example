# ========================================================
# BAMBA AQUA - Variáveis de Ambiente do Docker Compose
# ========================================================

# Portas de Acesso Externo
FRONTEND_PORT=80
BACKEND_PORT=8080
DB_PORT=5432

# Banco de Dados PostgreSQL
DB_NAME=storedb
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui

# Segurança e JWT
# Segredo Base64 (>= 256 bits) para assinatura HMAC-SHA256
JWT_SECRET=seu_jwt_secret_base64_com_ao_menos_256_bits_aqui
JWT_EXPIRATION_MS=43200000
