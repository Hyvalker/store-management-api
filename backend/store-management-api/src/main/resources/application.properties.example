spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/storedb}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:postgres_password_dev}

spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:false}
spring.jpa.open-in-view=false

# ===================== DOCUMENTAÇÃO SWAGGER / OPENAPI =====================
springdoc.api-docs.enabled=${SPRINGDOC_ENABLED:true}
springdoc.swagger-ui.enabled=${SPRINGDOC_ENABLED:true}

# ===================== SEGURANÇA E JWT =====================
# Chave secreta em Base64 (>= 256 bits / 32 bytes) para assinatura HMAC-SHA256
security.jwt.secret=${SECURITY_JWT_SECRET:YmFtYmEtYXF1YS1kZXYtc2VjcmV0LWtleS1mb3ItbG9jYWwtZGV2ZWxvcG1lbnQtb25seS0yMDI2}
# Validade do token em milissegundos (43200000 ms = 12 horas)
security.jwt.expiration-ms=${SECURITY_JWT_EXPIRATION_MS:43200000}

# CORS - Origens permitidas (separadas por vírgula em prod)
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173}
